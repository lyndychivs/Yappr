# create your own .env file based on this template
YAPPR_DISCORD_PORT=6070
ASPIRE_API_PORT=18888
ASPIRE_OTLP_PORT=18889

DASHBOARD_OTLP_API_KEY=
DASHBOARD_FRONTEND_AUTHMODE=BrowserToken
DASHBOARD_FRONTEND_BROWSERTOKEN=

DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=

# MCP server connection — points at the yappr-mcp service (backed by a local Ollama model), pre-wired by
# docker-compose. MCP_COMMAND/MCP_ARGUMENTS are only used for the Stdio transport and can be left blank.
MCP_TRANSPORT=Http
MCP_COMMAND=
MCP_ARGUMENTS=
MCP_HTTP_ENDPOINT=http://yappr-mcp:8080/
MCP_TOOL_NAME=chat

# Local model served by yappr-mcp's Ollama backend. Must be pulled once via:
#   docker compose -f deploy/docker-compose.yaml exec ollama ollama pull <model>
OLLAMA_MODEL=llama3.1:8b

TLDR_MAX_DAYS=30
TLDR_MAX_HOURS=720
TLDR_MAX_MESSAGES=500
